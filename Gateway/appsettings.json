{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 4
      }
    ]
  },

  "ReverseProxy": {
    "Routes": {
      "book-route": {
        "ClusterId": "book-service",
        "Match": {
          "Path": "/books/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/app/book/{**catch-all}"
          }
        ]
      },

      "member-route": {
        "ClusterId": "member-service",
        "Match": {
          "Path": "/members/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/app/member/{**catch-all}"
          }
        ]
      }
    },

    "Clusters": {
      "book-service": {
        "Destinations": {
          "book-api": {
            "Address": "https://localhost:5001/"
          }
        }
      },

      "member-service": {
        "Destinations": {
          "member-api": {
            "Address": "https://localhost:5002/"
          }
        }
      }
    }
  }
}
    
  

